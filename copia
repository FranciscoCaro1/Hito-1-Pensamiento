import csv, sys, time, heapq, random

# Configuración de límites y archivos
LIMITE_TIEMPO = 9.0  # Para cumplir con el umbral de < 10s
ARCHIVO_TAREAS = "tareas_3.txt"
ARCHIVO_RECURSOS = "recursos_3.txt"

def leer_tareas(nombre):
    try:
        with open(nombre, encoding="utf-8") as f:
            # Formato esperado: ID, Duracion, Categoria
            return [{"id": x[0].strip(), "dur": int(x[1]), "cat": x[2].strip()}
                    for x in csv.reader(f) if len(x) >= 3]
    except Exception as e:
        print(f"Error al leer tareas: {e}")
        return []

def leer_recursos(nombre):
    try:
        with open(nombre, encoding="utf-8") as f:
            # Formato esperado: ID, CAT1, CAT2, ...
            recursos = []
            for x in csv.reader(f):
                if len(x) >= 2:
                    rid = x[0].strip()
                    cats = {c.strip() for c in x[1:] if c.strip()}
                    recursos.append({"id": rid, "cats": cats})
            return recursos
    except Exception as e:
        print(f"Error al leer recursos: {e}")
        return []

def compatibilidad(tareas, recursos):
    por_cat = {}
    cats_recurso = {}
    comp = {}
    for r in recursos:
        rid = r["id"]
        cats_recurso[rid] = r["cats"]
        for c in r["cats"]:
            por_cat.setdefault(c, []).append(rid)
    for t in tareas:
        comp[t["id"]] = por_cat.get(t["cat"], [])
    return comp, cats_recurso, por_cat

def construir(tareas, comp, cats_recurso, peso):
    libre = {} # Tiempo en que el recurso queda libre
    asig = []
    heaps = {}
    
    for t in tareas:
        tid, cat = t["id"], t["cat"]
        recursos_validos = comp.get(tid, [])
        
        if not recursos_validos:
            continue
            
        if cat not in heaps:
            h = [(0, peso.get(r, 0), r) for r in recursos_validos]
            heapq.heapify(h)
            heaps[cat] = h
            
        h = heaps[cat]
        # Sincronizar heap con el tiempo real de 'libre'
        while h and h[0][0] != libre.get(h[0][2], 0):
            heapq.heappop(h)
            
        if not h:
            h = [(libre.get(r, 0), peso.get(r, 0), r) for r in recursos_validos]
            heapq.heapify(h)
            heaps[cat] = h
            
        ini, p, r = heapq.heappop(h)
        fin = ini + t["dur"]
        
        asig.append([tid, r, ini, fin])
        libre[r] = fin
        
        # Actualizar este recurso en los heaps de todas las categorías que soporta
        for c_comp in cats_recurso[r]:
            if c_comp in heaps:
                heapq.heappush(heaps[c_comp], (fin, p, r))
    return asig

def validar(asig, tareas, comp):
    if not asig: return False
    dur_dict = {t["id"]: t["dur"] for t in tareas}
    vistos = set()
    por_recurso = {}
    
    for tid, rid, ini, fin in asig:
        # 1. Verificar compatibilidad de categoría
        if rid not in comp.get(tid, []):
            print(f"ERROR: Tarea {tid} no compatible con recurso {rid}")
            return False
        # 2. Verificar duración correcta
        if fin - ini != dur_dict.get(tid, 0):
            print(f"ERROR: Duración incorrecta en tarea {tid}")
            return False
        # 3. Verificar que no se repita la tarea
        if tid in vistos:
            print(f"ERROR: Tarea {tid} duplicada")
            return False
        
        vistos.add(tid)
        por_recurso.setdefault(rid, []).append((ini, fin))
    
    # 4. Verificar solapamiento en el tiempo por recurso
    for rid, intervalos in por_recurso.items():
        intervalos.sort()
        for i in range(1, len(intervalos)):
            if intervalos[i][0] < intervalos[i-1][1]:
                print(f"ERROR: Solapamiento en recurso {rid}")
                return False
    return True

def escribir(asig, nombre="output.txt"):
    with open(nombre, "w", encoding="utf-8", newline="") as f:
        writer = csv.writer(f)
        writer.writerows(asig)

def main():
    print("Iniciando sistema de planificación...")
    tareas = leer_tareas(ARCHIVO_TAREAS)
    recursos = leer_recursos(ARCHIVO_RECURSOS)
    
    if not tareas or not recursos:
        print("Faltan archivos de entrada.")
        return

    comp, cats_recurso, por_cat = compatibilidad(tareas, recursos)
    
    # Calcular pesos para equilibrar la carga (heurística)
    rareza = {c: 1 / len(v) for c, v in por_cat.items() if v}
    peso = {r: sum(rareza.get(c, 0) for c in cats) for r, cats in cats_recurso.items()}
    
    # Ordenar tareas por duración (las más largas primero suelen dar mejor makespan)
    tareas_ordenadas = sorted(tareas, key=lambda x: x["dur"], reverse=True)
    
    print("Asignando tareas...")
    resultado = construir(tareas_ordenadas, comp, cats_recurso, peso)
    
    print("Validando cronograma...")
    if validar(resultado, tareas, comp):
        escribir(resultado)
        mspan = max(x[3] for x in resultado)
        print(f"¡Éxito! Archivo 'output.txt' generado.")
        print(f"Makespan obtenido: {mspan}")
    else:
        print("El cronograma generado no es válido.")

if __name__ == "__main__":
    main()